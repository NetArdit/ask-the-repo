# Copy this file to .env.local and fill in the values. .env.local is gitignored; never commit real secrets.

# Required. Groq API key (free plan, no card). Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Required. Exact Groq model id. The code never guesses one. Example: openai/gpt-oss-120b
GROQ_MODEL=

# Required unless INDEX_STORE_URL is set. Local folder where built repository indexes are stored.
INDEX_STORE_DIR=.index-store

# Optional. Read-only GitHub token, no scopes. Without it GitHub allows about 60 requests per hour,
# and every answer fetches several files, so set it for anything beyond a quick test.
GITHUB_TOKEN=

# Optional. Set to 1 only when a proxy you control appends the client address to X-Forwarded-For;
# rate limits are then also counted per client.
TRUST_PROXY=

# Optional. Ceiling on model calls per day for this server process (default 25).
ANSWERS_PER_DAY=

# Optional. Size limit in MB for INDEX_STORE_DIR (default 512). The oldest indexes are removed first.
INDEX_STORE_MAX_MB=

# Optional. How many repositories may be indexed at once (default 2). Use 1 on a host with little memory.
INGEST_CONCURRENCY=
